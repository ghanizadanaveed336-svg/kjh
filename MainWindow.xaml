<Window x:Class="TailorShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailor Shop Manager"
        Width="1380" Height="860"
        WindowStartupLocation="CenterScreen"
        Background="#050505" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E0E0E" BorderBrush="#D4A63F" BorderThickness="0,0,1,0">
            <StackPanel Margin="18,20,12,20">
                <Border Width="170" Height="170" CornerRadius="85"
                        BorderBrush="#D4A63F" BorderThickness="3" Background="#090909"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Viewbox>
                        <Canvas Width="240" Height="240">
                            <Ellipse Width="220" Height="220" Canvas.Left="10" Canvas.Top="10"
                                     Stroke="#D4A63F" StrokeThickness="6" Fill="Transparent"/>
                            <Ellipse Width="186" Height="186" Canvas.Left="27" Canvas.Top="27"
                                     Stroke="#D4A63F" StrokeThickness="3" Fill="Transparent" Opacity="0.8"/>

                            <Path Data="M70,95 L94,112 L118,95 L140,112 L165,95 L165,120 L140,140 L118,120 L94,140 L70,120 Z"
                                  Fill="#0B0B0B" Stroke="#D4A63F" StrokeThickness="2"/>

                            <Path Data="M95,102 L118,128 L142,102" Stroke="#D4A63F" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M86,120 L70,160 L90,170 L110,140 L118,200 L126,140 L146,170 L166,160 L150,120" Fill="#0E0E0E" Stroke="#D4A63F" StrokeThickness="2"/>
                            <Path Data="M118,128 L118,200" Stroke="#D4A63F" StrokeThickness="3"/>
                            <Path Data="M85,125 L55,160" Stroke="#D4A63F" StrokeThickness="4"/>
                            <Path Data="M150,125 L180,160" Stroke="#D4A63F" StrokeThickness="4"/>

                            <Path Data="M45,95 L90,120" Stroke="#D4A63F" StrokeThickness="3"/>
                            <Path Data="M190,95 L145,120" Stroke="#D4A63F" StrokeThickness="3"/>

                            <Path Data="M35,138 A30,30 0 1,1 95,138" Stroke="#D4A63F" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M145,138 A30,30 0 1,0 205,138" Stroke="#D4A63F" StrokeThickness="3" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="TAILOR" FontSize="38" FontWeight="Bold" Foreground="#E8C96A"
                           HorizontalAlignment="Center" FontFamily="Impact" LetterSpacing="1"/>
                <TextBlock Text="Tailoring &amp; Clothing" FontSize="15" Foreground="#C9B77B"
                           HorizontalAlignment="Center" Margin="0,5,0,18"/>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Dashboard" Margin="0,12" FontWeight="Bold" Foreground="#F0D479" FontSize="16"/>
                    <TextBlock Text="Customers" Margin="0,8" Foreground="#EAEAEA" FontSize="14"/>
                    <TextBlock Text="Orders" Margin="0,8" Foreground="#EAEAEA" FontSize="14"/>
                    <TextBlock Text="Measurements" Margin="0,8" Foreground="#EAEAEA" FontSize="14"/>
                    <TextBlock Text="Payments" Margin="0,8" Foreground="#EAEAEA" FontSize="14"/>
                    <TextBlock Text="Backup" Margin="0,8" Foreground="#EAEAEA" FontSize="14"/>
                </StackPanel>

                <Button Content="New Customer" Width="180" Height="42" Margin="0,20,0,10"
                        Background="#D4A63F" Foreground="#111111" FontWeight="Bold" BorderBrush="#F1D784"/>
                <Button Content="New Order" Width="180" Height="42" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,20,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#121212" CornerRadius="18" BorderBrush="#3A3A3A" BorderThickness="1" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Aqib Shah Tailoring &amp; Clothing" Foreground="#F2D37A" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Management Dashboard" Foreground="#C6C3BE" FontSize="14" Margin="4,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Export" Width="110" Margin="0,0,10,0"/>
                        <Button Content="Import" Width="110" Background="#D4A63F" Foreground="#101010" FontWeight="Bold" BorderBrush="#F0D791"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,10,0" Background="#171717" CornerRadius="18" Padding="18" BorderBrush="#2B2B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Active Orders" Foreground="#A09F9A" FontSize="13"/>
                            <TextBlock Text="12" Foreground="#F0D786" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="0,0,10,0" Background="#171717" CornerRadius="18" Padding="18" BorderBrush="#2B2B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Late Deliveries" Foreground="#A09F9A" FontSize="13"/>
                            <TextBlock Text="04" Foreground="#FF6B6B" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="0,0,10,0" Background="#171717" CornerRadius="18" Padding="18" BorderBrush="#2B2B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Today Income" Foreground="#A09F9A" FontSize="13"/>
                            <TextBlock Text="$4,560" Foreground="#7BE3A3" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#171717" CornerRadius="18" Padding="18" BorderBrush="#2B2B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Outstanding" Foreground="#A09F9A" FontSize="13"/>
                            <TextBlock Text="$2,830" Foreground="#EEC45F" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#141414" CornerRadius="20" BorderBrush="#2B2B2B" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Recent Orders" Foreground="#F1D66D" FontSize="18" FontWeight="Bold"/>

                            <DataGrid Grid.Row="1" Margin="0,16,0,0" AutoGenerateColumns="False" Background="#111111" RowBackground="#111111" AlternatingRowBackground="#171717"
                                      HeadersVisibility="Column" CanUserAddRows="False" BorderThickness="0" Foreground="#F2F2F2" FontSize="13">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding No}" Width="70"/>
                                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="110"/>
                                    <DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="18,0,0,0" Background="#141414" CornerRadius="20" BorderBrush="#2B2B2B" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" Foreground="#F1D66D" FontSize="18" FontWeight="Bold"/>
                            <Button Content="Add Customer" Margin="0,18,0,10" Height="42"/>
                            <Button Content="Create Order" Margin="0,0,0,10" Height="42"/>
                            <Button Content="Receive Payment" Margin="0,0,0,10" Height="42"/>
                            <Button Content="Print Slip" Margin="0,0,0,10" Height="42"/>
                            <Button Content="Backup" Height="42" Background="#D4A63F" Foreground="#101010" FontWeight="Bold" BorderBrush="#F0D791"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
