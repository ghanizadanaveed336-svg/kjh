<Window x:Class="TailorShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqib Shah Tailoring &amp; Clothing"
        Width="1200"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#050505"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8E08C" Offset="0"/>
            <GradientStop Color="#D7A83F" Offset="0.35"/>
            <GradientStop Color="#B77D1D" Offset="0.72"/>
            <GradientStop Color="#F0D678" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="DarkBg" Color="#050505"/>
        <SolidColorBrush x:Key="BlackPanel" Color="#0C0C0C"/>
    </Window.Resources>

    <Grid Background="{StaticResource DarkBg}">
        <Grid Width="940" Height="940" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="930" Height="930" Stroke="{StaticResource GoldBrush}" StrokeThickness="12" Fill="Transparent"/>
            <Ellipse Width="860" Height="860" Stroke="{StaticResource GoldBrush}" StrokeThickness="4" Fill="Transparent" Opacity="0.8"/>

            <Canvas Width="930" Height="930" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Left scissors -->
                <Path Data="M154,520 L240,550 L220,600 L154,580 Z" Fill="#0B0B0B" Stroke="{StaticResource GoldBrush}" StrokeThickness="7"/>
                <Path Data="M160,528 L108,470" Stroke="{StaticResource GoldBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M160,528 L118,610" Stroke="{StaticResource GoldBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M108,470 L90,420" Stroke="{StaticResource GoldBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M118,610 L92,700" Stroke="{StaticResource GoldBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M160,555 L118,470" Stroke="#0A0A0A" StrokeThickness="5"/>
                <Path Data="M158,555 L114,620" Stroke="#0A0A0A" StrokeThickness="5"/>
                <Path Data="M110,468 L150,458" Stroke="{StaticResource GoldBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M110,614 L152,608" Stroke="{StaticResource GoldBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="92" Canvas.Top="420" Width="24" Height="24" Fill="{StaticResource GoldBrush}"/>
                <Ellipse Canvas.Left="94" Canvas.Top="690" Width="24" Height="24" Fill="{StaticResource GoldBrush}"/>

                <!-- Mannequin body -->
                <Ellipse Canvas.Left="372" Canvas.Top="170" Width="180" Height="180" Fill="#0B0B0B" Stroke="{StaticResource GoldBrush}" StrokeThickness="7"/>
                <Path Data="M442,340 L505,500 L420,500 L382,340 Z" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="7"/>
                <Path Data="M392,350 L330,440 L300,520 L368,520 L420,470 L392,350 Z" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="6"/>
                <Path Data="M492,350 L560,440 L590,520 L520,520 L470,470 L492,350 Z" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="6"/>
                <Path Data="M430,330 L448,505 L470,330 Z" Fill="#0A0A0A" Stroke="{StaticResource GoldBrush}" StrokeThickness="5"/>
                <Path Data="M415,392 L448,440 L480,392" Stroke="{StaticResource GoldBrush}" StrokeThickness="4" Fill="Transparent"/>
                <Path Data="M448,440 L448,530" Stroke="{StaticResource GoldBrush}" StrokeThickness="5"/>
                <Path Data="M360,530 L448,560 L540,530" Stroke="{StaticResource GoldBrush}" StrokeThickness="6" Fill="Transparent"/>
                <Path Data="M448,560 L448,680" Stroke="{StaticResource GoldBrush}" StrokeThickness="7"/>
                <Path Data="M382,680 L438,718 L450,718 L448,680 Z" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="5"/>
                <Path Data="M514,680 L460,718 L450,718 L448,680 Z" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="5"/>

                <!-- Shirt / jacket silhouette -->
                <Path Data="M430,320 L404,390 L430,470 L448,470 L470,390 L448,320 Z" Fill="#0C0C0C" Stroke="{StaticResource GoldBrush}" StrokeThickness="4"/>
                <Rectangle Canvas.Left="440" Canvas.Top="395" Width="18" Height="86" Fill="#111111" Stroke="{StaticResource GoldBrush}" StrokeThickness="4"/>

                <!-- Tape measure -->
                <Path Data="M468,165 L446,640" Stroke="{StaticResource GoldBrush}" StrokeThickness="4" StrokeDashArray="2 12"/>
                <Path Data="M466,176 L520,176" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,240 L520,240" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,304 L520,304" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,368 L520,368" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,432 L520,432" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,496 L520,496" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,560 L520,560" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M466,624 L520,624" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>

                <!-- Decorative pocket -->
                <Path Data="M420,440 L458,472 L494,440" Stroke="{StaticResource GoldBrush}" StrokeThickness="4" Fill="Transparent"/>

                <!-- Right tape reel -->
                <Path Data="M700,540 C760,500 820,500 860,560 L860,670 C820,720 760,720 700,680 Z" Fill="#0F0F0F" Stroke="{StaticResource GoldBrush}" StrokeThickness="6"/>
                <Path Data="M710,545 C760,520 820,520 850,565" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M710,680 C760,704 820,704 850,660" Stroke="{StaticResource GoldBrush}" StrokeThickness="3"/>
                <Path Data="M711,548 L711,676" Stroke="{StaticResource GoldBrush}" StrokeThickness="4"/>
                <Path Data="M786,520 L786,680" Stroke="{StaticResource GoldBrush}" StrokeThickness="4"/>
                <Path Data="M820,515 L820,678" Stroke="{StaticResource GoldBrush}" StrokeThickness="4"/>
                <Path Data="M690,602 L860,602" Stroke="{StaticResource GoldBrush}" StrokeThickness="3" Opacity="0.75"/>
                <TextBlock Canvas.Left="720" Canvas.Top="610" Text="1 2 3 4 5" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontFamily="Verdana"/>
            </Canvas>

            <TextBlock Text="TAILOR" FontSize="240" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontFamily="Impact" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,105"/>
            <Path Data="M180,710 C260,660 400,640 520,700 S760,760 860,700" Stroke="{StaticResource GoldBrush}" StrokeThickness="8" StrokeLineCap="Round" Fill="Transparent"/>
            <TextBlock Text="TAILOR" FontSize="104" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" FontFamily="Impact" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Opacity="0.8"/>
        </Grid>
    </Grid>
</Window>
