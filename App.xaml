<Application x:Class="TailorShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundDark" Color="#050505"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#101010"/>
        <SolidColorBrush x:Key="PanelDark" Color="#171717"/>
        <SolidColorBrush x:Key="GoldPrimary" Color="#D4A63F"/>
        <SolidColorBrush x:Key="GoldLight" Color="#F7D676"/>
        <SolidColorBrush x:Key="GoldDark" Color="#8E6B22"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F1ED"/>
        <SolidColorBrush x:Key="TextMuted" Color="#B7B4AF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1F6FB5"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#D4A63F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1E1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
